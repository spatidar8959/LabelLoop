# Copy to .env and add your own Gemini API key.
# Never put this key in index.html or commit .env to Git.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Gemini 3.8 Flash Standard paid-tier rates through 31 Dec 2026 (USD per 1M tokens).
# Change these when Google's pricing changes, or set rates for your actual tier.
GEMINI_PRICE_INPUT_PER_M=0.75
GEMINI_PRICE_CACHED_PER_M=0.075
GEMINI_PRICE_OUTPUT_PER_M=3.75
GEMINI_MAX_OUTPUT_TOKENS=16384

# Local server settings
HOST=127.0.0.1
PORT=4173
AI_MAX_CONCURRENCY=2
MAX_REQUEST_MB=32
